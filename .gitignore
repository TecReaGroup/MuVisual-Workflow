# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment and logs
.env
.env.*
*.log

# Keep directory placeholders if they are added to the repository.
!data/**/.gitkeep

# Large local audio/model assets and generated outputs
data/audio/*
!data/audio/.gitkeep
data/model/*
!data/model/.gitkeep
data/stem/*
!data/stem/.gitkeep
data/stem_gated/*
!data/stem_gated/.gitkeep
data/midi/*
!data/midi/.gitkeep
data/midi_fixed/*
!data/midi_fixed/.gitkeep
